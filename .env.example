# BAI Technology — ortam değişkenleri örneği
# Gerçek değerleri BURAYA YAZMAYIN. Bu dosya yalnızca anahtar isimlerini
# belgelemek içindir. Yerel geliştirme için .env.local oluşturun; production
# için Netlify panelinde (Site settings → Environment variables) tanımlayın.

# İletişim formu (/api/contact) — Gmail SMTP ile e-posta gönderimi.
# Runtime'da (Netlify Function) gerekir; build sırasında GEREKMEZ.
# NEXT_PUBLIC_ öneki YOK — bunlar gizli, sunucu tarafı değişkenlerdir,
# tarayıcıya sızmamalıdır.

# Gönderen Gmail hesabının adresi (ör. info@baitech.com.tr veya bir Gmail adresi)
EMAIL_HOST_USER=

# Gmail "Uygulama Şifresi" (App Password) — normal hesap şifresi DEĞİL.
# 2FA açık bir Google hesabında oluşturulur (Google Hesabı → Güvenlik →
# Uygulama Şifreleri). 16 haneli, boşluksuz.
EMAIL_HOST_PASSWORD=
