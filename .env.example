# ============================================================
# BAI Teknoloji — ortam değişkenleri şablonu
# ------------------------------------------------------------
# Yerelde: bu dosyayı .env olarak kopyalayıp doldurun.
# Netlify: Site configuration → Environment variables (TÜMÜ gerekli).
# Gerçek değerler ASLA commit edilmez (.gitignore: .env*, yalnız bu şablon izlenir).
#
# NEXT_PUBLIC_ önekliler tarayıcıya gömülür (gizli değildir; güvenlik
# Firestore kuralları + admin custom claim ile sağlanır). Öneksizler
# YALNIZCA sunucuda okunur — asla client koduna taşımayın.
# ============================================================

# ---------- FIREBASE (client SDK — panel girişi + Firestore) ----------
# Firebase Console → Project settings → General → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- FIREBASE ADMIN SDK (sunucu — BUILD'DE DE GEREKLİ) ----------
# Public sayfalar build/ISR sırasında Firestore'u Admin SDK ile okur;
# oturum doğrulama ve form maili de bunu kullanır.
# Project settings → Service accounts → Generate new private key ile inen
# JSON'un TEK SATIR base64 hali:  base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# ---------- ADMIN (yalnızca yerel script'ler / testler) ----------
# Panel kullanıcısı Firebase Auth'ta durur; şifre koda gömülmez.
# `npm run set-admin-claim` bu e-postaya admin:true claim'i atar.
# Netlify'da TANIMLAMAYIN (site çalışmak için ihtiyaç duymaz).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- CLOUDINARY ----------
# Görsel teslimi + panelden unsigned upload (client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# İmzalı silme (öksüz görsel temizliği) — yalnız sunucu
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- RESEND (iletişim formu e-postası — yalnız sunucu) ----------
# Boş bırakılırsa mail adımı sessizce atlanır; kayıt yine Gelen Kutusu'na düşer.
RESEND_API_KEY=
# Doğrulanmış domain'den gönderen: "noreply@baitech.com.tr" veya "BAI Technology <noreply@baitech.com.tr>"
RESEND_FROM_EMAIL=

# ---------- SİTE ----------
# Canonical, sitemap, OG ve schema URL'lerinin kökü (sonda / yok)
NEXT_PUBLIC_SITE_URL=https://baitech.com.tr
